# =============================================================================
# SmartCart AI — Backend Environment Variables (.env.example)
# Copy to server/.env for local development or configure in Render / Railway.
# NEVER commit real API keys, passwords, or secrets to Git.
# =============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Persistent SQLite Database Path
# - Local development: ./data/shopping.sqlite
# - Render Persistent Disk: /var/data/shopping.sqlite
# - Railway Persistent Volume: /data/shopping.sqlite
DATABASE_FILE=/var/data/shopping.sqlite

# CORS Allowed Origins (comma-separated list of frontend URLs)
# Leave empty when proxying /api/* via Vercel rewrites on the same domain,
# or specify your Vercel production & preview URLs:
CORS_ALLOWED_ORIGINS=https://your-smartcart-app.vercel.app,https://*.vercel.app

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS_EXTRACTION=350
GEMINI_MAX_OUTPUT_TOKENS_EXPLANATION=600
GEMINI_MAX_RETRIES=1
GEMINI_DAILY_REQUEST_BUDGET=500
GEMINI_DAILY_TOKEN_BUDGET=250000
GEMINI_INPUT_COST_PER_1M_USD=0.15
GEMINI_OUTPUT_COST_PER_1M_USD=0.60

# Session & Request Throttling
SESSION_THROTTLE_MS=1000
DUPLICATE_SUBMIT_WINDOW_MS=3000

# Authentication & Security
# Demo admin ('admin' / 'admin') is strictly disabled when NODE_ENV=production.
ENABLE_DEMO_ADMIN=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@smartcart.ai
# Set a strong password (minimum 8 characters, not 'admin') to bootstrap the initial production admin:
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_COOKIE_NAME=shp_session
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional Cross-Retailer Live Offer Providers
SERPAPI_API_KEY=
RAPIDAPI_PRODUCT_SEARCH_KEY=
RAPIDAPI_PRODUCT_SEARCH_HOST=real-time-product-search.p.rapidapi.com
OFFER_CACHE_TTL_MS=900000
OFFER_REFRESH_COOLDOWN_MS=30000
OFFER_PROVIDER_TIMEOUT_MS=5000
OFFER_PROVIDER_MAX_RETRIES=1
