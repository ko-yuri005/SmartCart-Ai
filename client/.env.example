# =============================================================================
# SmartCart AI — Frontend Environment Variables (.env.example)
# =============================================================================

# Optional API Base URL
# Leave empty ("") when using Vercel's /api/* rewrite proxy in vercel.json (Recommended:
# keeps all /api/* requests same-origin so HttpOnly SameSite=Lax cookies work natively).
# Set only if calling an external backend directly without Vercel rewrites.
VITE_API_BASE_URL=
